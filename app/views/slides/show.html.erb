<div class="deck">
  <% @presentation.parts.each do |part| %>
    <% part.chapters.each do |chapter| %>
      <% chapter.slides.each do |slide| %>
        <%= render "presentations/slide", presentation: @presentation, slide: slide, part: part, chapter: chapter %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "presentations/chrome", presentation: @presentation %>
</div>
