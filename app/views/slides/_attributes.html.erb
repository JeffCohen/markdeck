<div class="editor__attrs">
  <label class="editor__attr">
    <input type="checkbox"
           data-action="change->editor#toggleCenter"
           <%= "checked" if slide.centered? %>>
    <span>Center</span>
  </label>

  <label class="editor__attr">
    <span class="editor__attr-label">Label</span>
    <%# change-> not input->: rewriting front matter on every keystroke meant a
        parse-and-rewrite (and a focus round trip through the textarea) per
        character. Committing on blur/Enter keeps the field as a syntax helper
        without fighting the editor while you type. %>
    <input type="text"
           data-editor-target="labelInput"
           data-action="change->editor#setLabel"
           value="<%= slide.label %>"
           placeholder="(shown in overview & ⌘K)">
  </label>

  <label class="editor__attr">
    <span class="editor__attr-label">Chapter</span>
    <input type="text"
           data-editor-target="chapterInput"
           data-action="change->editor#setChapter"
           value="<%= slide.chapter %>"
           placeholder="(optional grouping)">
  </label>

  <label class="editor__attr">
    <span class="editor__attr-label">Part</span>
    <input type="text"
           data-editor-target="partInput"
           data-action="change->editor#setPart"
           value="<%= slide.part %>"
           placeholder="(groups chapters)">
  </label>

  <span class="editor__attrs-hint">Front-matter at the top of the file.</span>
</div>
