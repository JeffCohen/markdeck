<section
  class="slide"
  data-deck-target="slide"
  data-slide-index="<%= slide.index %>"
  aria-hidden="true"
>
  <%# Same 1280x720 canvas markup as the editor preview and overview thumbs,
      scaled to fit the viewport by deck_controller#scaleSlides. `slide--center`
      goes on the canvas (not the section) so it matches where the preview puts
      it and picks up the shared centering rule. %>
  <div class="slide-stage">
    <div class="thumb-preview">
      <div class="thumb-content slide-content<%= ' slide--center' if slide.centered? %>">
        <%== slide.html %>
      </div>
    </div>
  </div>

  <% if slide.notes? %>
    <aside class="speaker-peek speaker-peek--notes" aria-hidden="true">
      <div class="speaker-peek__label">
        Notes &middot; slide <%= slide.number %>
      </div>
      <div class="speaker-peek__body slide-content">
        <%== slide.notes_html %>
      </div>
    </aside>
  <% end %>

  <% if (nxt = presentation.slides[slide.index + 1]) %>
    <aside class="speaker-peek speaker-peek--preview" aria-hidden="true">
      <div class="speaker-peek__label">
        Next &middot; <%= nxt.number %> &middot; <%= nxt.title %>
      </div>
      <div class="thumb-preview">
        <div class="thumb-content slide-content">
          <%== nxt.html %>
        </div>
      </div>
    </aside>
  <% end %>
</section>
